  "emulators": {
    "hosting": {
      "port": 5050
    },
    "functions": {
      "port": 5051
    },
    "firestore": {
      "port": 5052
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
